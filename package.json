{
  "name": "les-bms",
  "version": "1.0.0",
  "description": "EZOLA Lodge & Restaurant Business Management System - Phase 1 (React + Express + PostgreSQL)",
  "main": "server/index.js",
  "engines": { "node": "20.x" },
  "scripts": {
    "dev": "nodemon server/index.js",
    "start": "node server/index.js",
    "client": "npm run dev --prefix client",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node db/seed.js",
    "heroku-postbuild": "npm install --prefix client --include=dev && npm run build --prefix client"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": { "nodemon": "^3.1.4" }
}
